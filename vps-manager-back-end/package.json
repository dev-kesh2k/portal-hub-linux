{
  "name": "vps-manager-back-end",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "cf:verify": "node scripts/cloudflare-cli.js verify",
    "cf:tunnels": "node scripts/cloudflare-cli.js tunnels",
    "cf:check": "node scripts/cloudflare-cli.js full",
    "cf:fix-env": "node scripts/cloudflare-cli.js fix-env",
    "cf:sync": "tsx scripts/sync-cloudflare.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.3.0",
    "node-pty": "^1.0.0",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  },
  "allowScripts": {}
}
