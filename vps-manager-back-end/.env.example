PORT=3001
PUBLIC_ORIGIN=https://central-apps-hub.com.br
# appliance | linux | (vazio = WSL no Windows)
# HUB_RUNTIME=appliance
# API token com permissão "Account → Cloudflare Tunnel → Edit"
CF_API_TOKEN=
# ID da conta (32 caracteres hex) em dash.cloudflare.com
CF_ACCOUNT_ID=
# UUID do túnel (Zero Trust → Networks → Tunnels → copiar Tunnel ID)
CF_TUNNEL_ID=
# Token de execução do cloudflared (começa com eyJ... ou cfut_...) — NÃO é o Tunnel ID
CF_TUNNEL_TOKEN=
CF_ORIGIN_SERVICE=http://127.0.0.1:8081
WSL_DISTRO=Ubuntu
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
# Root do Hub (não cria usuário Linux). Usuários da página Usuários ficam no PostgreSQL.
CORS_ORIGIN=https://central-apps-hub.com.br
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=central_apps_hub
DATABASE_POOL_MAX=4
APACHE_BACKEND_HOST=172.17.0.1
HUB_APP_DB_HOST=172.17.0.1
NODE_OPTIONS=--max-old-space-size=384
